{
  "description": "Global knowledge base: auto-load the cross-project knowledge index at session start (every session, any repo), copy per-project skills from the canonical ia repo into the current clone's .claude/skills, and remind to capture reusable knowledge before context compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/knowledge-base/scripts/session_start.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/link_project_skills.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/knowledge-base/scripts/remind_capture.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
