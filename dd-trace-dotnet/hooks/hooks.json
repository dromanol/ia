{
  "description": "dd-trace-dotnet knowledge base: auto-load the knowledge index at session start (only inside the dd-trace-dotnet repo) and remind to capture reusable knowledge before context compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/knowledge-base/scripts/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/knowledge-base/scripts/remind_capture.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
